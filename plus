from datetime import datetime
import sys

LOGFILE = "log.txt"

print("ログ開始（終了するには exit ）")

# CI やパイプ入力時は即終了（無限待ち防止）
if not sys.stdin.isatty():
    print(">")
    sys.exit(0)

while True:
    msg = input("> ").strip()

    if msg.lower() == "exit":
        print("終了します。")
        break

    if not msg:
        continue

    timestamp = datetime.now().strftime("[%Y-%m-%d %H:%M:%S]")
    log_line = f"{timestamp} {msg}"

    # 標準出力に表示（仕様対応）
    print(log_line)

    # ファイルへ追記保存
    with open(LOGFILE, "a", encoding="utf-8") as f:
        f.write(log_line + "\n")

