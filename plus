from datetime import datetime

LOGFILE = "log.txt"

print("ログ開始（終了するには exit ）")
while True:
    msg = input("> ").strip()
    if msg.lower() == "exit":
        print("終了します。")
        break

    # 空のメッセージは無視
    if not msg:
        continue

    # 現在時刻
    timestamp = datetime.now().strftime("[%Y-%m-%d %H:%M:%S]")

    # ファイルに追記
    with open(LOGFILE, "a", encoding="utf-8") as f:
        f.write(f"{timestamp} {msg}\n")

    print("✓ 保存しました")

