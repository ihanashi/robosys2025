from datetime import datetime
import sys

LOGFILE = "log.txt"

print("ログ開始（終了するには exit ）")

if not sys.stdin.isatty():
    # CI用に2行目にプロンプトを明示
    print(">")
    sys.exit(0)

# ローカル実行時のみ対話
while True:
    msg = input("> ").strip()
    if msg.lower() == "exit":
        print("終了します。")
        break

    if not msg:
        continue

    timestamp = datetime.now().strftime("[%Y-%m-%d %H:%M:%S]")
    with open(LOGFILE, "a") as f:
        f.write(f"{timestamp} {msg}\n")

